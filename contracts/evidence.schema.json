{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeforeTibo Repo Book Evidence Index v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "real",
        "demo"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "source_reference",
              "executed_check",
              "inference"
            ]
          },
          "source_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_blob_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "line_end": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "check_evidence_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "claim_id",
          "claim",
          "evidence_kind",
          "source_path",
          "source_blob_sha256",
          "line_start",
          "line_end",
          "symbol",
          "check_evidence_path",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "source_commit",
    "claims"
  ],
  "additionalProperties": false
}
