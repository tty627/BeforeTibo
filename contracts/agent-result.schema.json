{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeforeTibo Untrusted Agent Result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "candidate",
        "blocked",
        "no_progress"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "logical_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "test_patch",
              "tool",
              "reproduction",
              "experiment"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "logical_key",
          "title",
          "kind",
          "paths",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "source_read",
              "check_attempted",
              "unverified"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "relative_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          }
        },
        "required": [
          "kind",
          "summary",
          "relative_paths"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_next_unit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "outcome",
    "summary",
    "artifact_candidates",
    "observations",
    "blockers",
    "proposed_next_unit"
  ],
  "additionalProperties": false
}
