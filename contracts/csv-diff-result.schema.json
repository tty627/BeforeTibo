{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeforeTibo CSV Diff Export v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "key_column": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "before_rows": {
          "type": "integer",
          "minimum": 0
        },
        "after_rows": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "before_rows",
        "after_rows",
        "added",
        "removed",
        "changed",
        "unchanged"
      ],
      "additionalProperties": false
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "changed_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "before",
          "after",
          "changed_columns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "key_column",
    "columns",
    "summary",
    "added",
    "removed",
    "changed"
  ],
  "additionalProperties": false
}
