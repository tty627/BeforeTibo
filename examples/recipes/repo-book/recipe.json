{
  "schema_version": "1.0",
  "id": "repo-book",
  "version": "0.1.0",
  "title": "Repo Book",
  "mode": "learn",
  "goal": "Create an evidence-backed, incrementally useful guide to the selected repository snapshot.",
  "input": {
    "kind": "repository",
    "languages": [],
    "package_manager": null,
    "test_framework": null
  },
  "capabilities": [
    "snapshot",
    "sandbox-exec"
  ],
  "permissions": {
    "source": "baseline-read-only",
    "writes": [
      "out/repo-book/**"
    ],
    "task_network": "deny",
    "execute_project_code": false
  },
  "artifact_kinds": [
    "document"
  ],
  "stages": [
    {
      "id": "overview",
      "title": "Project overview",
      "max_units": 1,
      "depends_on": [],
      "expected_paths": [
