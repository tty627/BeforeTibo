        "out/repo-book/evidence.json",
        "out/repo-book/limitations.md"
      ],
      "validators": [
        {
          "id": "output-scope",
          "required": true,
          "params": {}
        },
        {
          "id": "protected-inputs",
          "required": true,
          "params": {}
        },
        {
          "id": "required-files",
          "required": true,
          "params": {}
        },
        {
          "id": "source-references",
          "required": true,
          "params": {}
        },
        {
          "id": "safe-markdown",
          "required": true,
          "params": {}
        }
      ]
    },
    {
      "id": "module-guides",
      "title": "Core module guides",
      "max_units": 4,
